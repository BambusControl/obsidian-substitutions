{
  "name": "obsidian-substitutions",
  "version": "0.6.1",
  "description": "Obsidian plugin for substituting fragments of text.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "export-schema": "typescript-json-schema --required --strictNullChecks --validationKeywords --ignoreErrors --refs --id https://raw.githubusercontent.com/BambusControl/obsidian-substitutions/0.6.0/resources/save-data-schema.json --out ./resources/save-data-schema.json tsconfig.json SaveData",
    "test": "jest"
  },
  "keywords": [
    "obsidian"
  ],
  "private": true,
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "repository": "https://github.com/BambusControl/obsidian-substitutions",
  "author": {
    "name": "BambusControl",
    "url": "https://github.com/BambusControl"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@types/jest": "^30.0.0",
    "@types/node": "^18",
    "@types/papaparse": "^5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "builtin-modules": "^3",
    "esbuild": "^0",
    "esbuild-sass-plugin": "^3",
    "jest": "^30.5.2",
    "obsidian": "latest",
    "ts-jest": "^29.4.15",
    "tslib": "^2",
    "typescript": "^4",
    "typescript-json-schema": "^0"
  }
}
